{
  "dataset": {
    "name": "sunset_beach_signal_sd15_512x512"
  },
  "dc_methods": {
    "diffusion_backprop": {
      "enabled": true,
      "sigma_y": 0.0,
      "init_from_meas_backproj": true,
      "backproj_init_strength": 1.0,
      "outer_iterations": 500,
      "learning_rate": 0.01,
      "latent_l2_penalty": 0.0,
      "normalize_grad": false,
      "grad_clip": 1.0,
      "early_stop_patience": 25,
      "early_stop_min_rel_improvement": 0.0001,
      "checkpoint_denoiser": true,
      "log_every": 1
    }
  },
  "gen_recon": {
    "num_steps": 20,
    "guidance_scale": 7.5,
    "eta": 0.0
  },
  "image": {
    "height": 512,
    "width": 512
  },
  "ktilde": {
    "name": "Ktilde_SD15__fft__k0_512x512_S500_ns20"
  },
  "optim": {
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_eps": 1e-08
  },
  "output": {
    "plot_images": false,
    "save_images": true,
    "save_json": true,
    "save_mat": false,
    "save_npz": true
  },
  "reconstruction": {
    "prompt": "",
    "prompts": [
      "sunset beach"
    ]
  },
  "repro": {
    "cudnn_benchmark": false,
    "deterministic": false,
    "seed": 12345
  },
  "runtime": {
    "attention_slicing": "auto",
    "gradient_checkpointing": true,
    "torch_dtype": "float16"
  },
  "sampling": {
    "methods_enabled": {
      "cs": true,
      "mcs": false
    },
    "weighted_ls": true
  },
  "sweep": {
    "sampling_perc_list": [
      0.00125,
      0.00375,
      0.00625
    ],
    "repeats_per_setting": 1,
    "save_per_run_artifacts": true
  }
}
