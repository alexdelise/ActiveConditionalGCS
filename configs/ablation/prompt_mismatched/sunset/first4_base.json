{
  "dataset": {
    "name": "sunset_sandy_coast_signal_sd15_512x512"
  },
  "gen_recon": {
    "eta": 0.0,
    "guidance_scale": 7.5,
    "num_steps": 20
  },
  "image": {
    "height": 512,
    "width": 512
  },
  "ktilde": {
    "name": "Ktilde_SD15__fft__k0_512x512_S500_ns20"
  },
  "optim": {
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "adam_eps": 1e-08,
    "adam_stepsize": 100.0,
    "early_stop_loss": 1e-08,
    "log_every": 10,
    "lr_scale": 0.01,
    "nb_epochs": 1000
  },
  "output": {
    "plot_images": false,
    "save_images": true,
    "save_json": true,
    "save_mat": false,
    "save_npz": true
  },
  "reconstruction": {
    "prompt": "sunset beach",
    "prompts": null
  },
